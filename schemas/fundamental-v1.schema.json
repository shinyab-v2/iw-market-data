{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorporateFundamentalsV1",
  "type": "object",
  "required": [
    "schema_version",
    "ticker",
    "cik",
    "company_name",
    "currency",
    "accounting_standard",
    "updated_at_utc",
    "latest_period",
    "content_hash",
    "quarters"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["fundamental-v1"] },
    "ticker": { "type": "string" },
    "cik": { "type": "string" },
    "company_name": { "type": "string" },
    "currency": { "type": "string", "default": "USD" },
    "accounting_standard": { "type": "string", "enum": ["US-GAAP", "IFRS"] },
    "updated_at_utc": { "type": "string" },
    "latest_period": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "content_hash": { "type": "string" },
    "quarters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "period_end",
          "fiscal_year",
          "fiscal_period",
          "form",
          "filed_date",
          "accession"
        ],
        "properties": {
          "period_end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "period_start": { "type": ["string", "null"] },
          "fiscal_year": { "type": "integer" },
          "fiscal_period": { "type": "string", "enum": ["Q1", "Q2", "Q3", "Q4", "FY"] },
          "form": { "type": "string" },
          "filed_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "accession": { "type": "string" },
          "source_url": { "type": ["string", "null"] },
          "is_amendment": { "type": "boolean" },
          "income_statement": {
            "type": "object",
            "properties": {
              "revenue": { "type": ["number", "null"] },
              "gross_profit": { "type": ["number", "null"] },
              "operating_income": { "type": ["number", "null"] },
              "net_income": { "type": ["number", "null"] },
              "gaap_basic_eps": { "type": ["number", "null"] },
              "gaap_diluted_eps": { "type": ["number", "null"] },
              "diluted_shares": { "type": ["number", "null"] }
            }
          },
          "balance_sheet": {
            "type": "object",
            "properties": {
              "cash_and_equivalents": { "type": ["number", "null"] },
              "short_term_investments": { "type": ["number", "null"] },
              "total_cash_and_st_investments": { "type": ["number", "null"] },
              "current_debt": { "type": ["number", "null"] },
              "long_term_debt": { "type": ["number", "null"] },
              "total_debt": { "type": ["number", "null"] },
              "total_assets": { "type": ["number", "null"] },
              "total_liabilities": { "type": ["number", "null"] },
              "stockholders_equity": { "type": ["number", "null"] },
              "shares_outstanding": { "type": ["number", "null"] }
            }
          },
          "cash_flow": {
            "type": "object",
            "properties": {
              "operating_cash_flow": { "type": ["number", "null"] },
              "capex": { "type": ["number", "null"] },
              "free_cash_flow": { "type": ["number", "null"] }
            }
          },
          "derived": {
            "type": "object",
            "properties": {
              "revenue_yoy_pct": { "type": ["number", "null"] },
              "revenue_qoq_pct": { "type": ["number", "null"] },
              "eps_yoy_pct": { "type": ["number", "null"] },
              "gross_margin_pct": { "type": ["number", "null"] },
              "operating_margin_pct": { "type": ["number", "null"] },
              "net_margin_pct": { "type": ["number", "null"] },
              "fcf_margin_pct": { "type": ["number", "null"] },
              "debt_to_equity": { "type": ["number", "null"] },
              "debt_to_cash": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "ttm": {
      "type": "object",
      "properties": {
        "as_of_period": { "type": "string" },
        "revenue_ttm": { "type": ["number", "null"] },
        "net_income_ttm": { "type": ["number", "null"] },
        "operating_cash_flow_ttm": { "type": ["number", "null"] },
        "free_cash_flow_ttm": { "type": ["number", "null"] },
        "diluted_eps_ttm": { "type": ["number", "null"] }
      }
    },
    "quality": {
      "type": "object",
      "required": ["tier", "validation_checks", "verified_at_utc"],
      "properties": {
        "tier": { "type": "string", "enum": ["SOURCE_VERIFIED", "ACCOUNTING_VALIDATED"] },
        "validation_checks": { "type": "array", "items": { "type": "string" } },
        "verified_at_utc": { "type": "string" }
      }
    }
  }
}
